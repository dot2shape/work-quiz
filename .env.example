# 로컬 개발(wrangler dev)용 환경변수 예시. 실제 값은 `.dev.vars`(gitignore)에 넣는다.
# 프로덕션 키는 절대 파일로 두지 말고 `npx wrangler secret put STDICT_API_KEY` 로만 등록한다.

# 국립국어원 표준국어대사전 오픈 API 키 (https://stdict.korean.go.kr/openapi/openApiInfo.do)
# 비어 있으면 data/seed_words.txt 기반 로컬 사전으로 동작한다 (개발용).
STDICT_API_KEY=

# 게임 규칙 기본값은 wrangler.toml [vars] 에 있다
TARGET_SCORE=5
ROUND_SECONDS=20
